# ==============================================================================
# RAG with Ollama - Environment Configuration Template
# Copy this file to '.env' and modify values as needed:
#   cp .env.example .env
# ==============================================================================

# ==============================================================================
# Application & Server Configuration
# ==============================================================================
API_HOST=0.0.0.0
API_PORT=8000

# ==============================================================================
# Storage Paths
# ==============================================================================
# Path where uploaded files are saved (absolute or relative to project root)
UPLOAD_DIR=data/uploads
# Directory where FAISS vector index and metadata are persisted
VECTOR_DB_PATH=db/faiss_index

# ==============================================================================
# Logging Configuration
# ==============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# Path to application log file (absolute or relative to project root)
LOG_FILE=logs/app.log

# ==============================================================================
# Ollama Service Configuration
# ==============================================================================
# Ollama server base endpoint URL
OLLAMA_BASE_URL=http://localhost:11434
# LLM model for question answering (must be pulled in Ollama, e.g., llama3.2:3b, mistral, llama3)
OLLAMA_LLM_MODEL=llama3.2:3b
# Embedding model for vector representation (must be pulled in Ollama, e.g., nomic-embed-text)
OLLAMA_EMBED_MODEL=nomic-embed-text
# Request timeout for Ollama operations (in seconds)
OLLAMA_TIMEOUT=120.0

# ==============================================================================
# Text Chunking & Vector Retrieval Settings
# ==============================================================================
# Number of words per text chunk during document ingestion
CHUNK_SIZE=500
# Number of overlapping words between consecutive chunks
CHUNK_OVERLAP=50
# Number of most relevant document chunks to retrieve for Q&A
TOP_K=3

# ==============================================================================
# Embedding & Context Limit Settings
# ==============================================================================
# Maximum characters sent to the embedding model per chunk
MAX_EMBED_CHARS=4000
# Maximum concatenated context characters passed to LLM prompt (prevents chunk truncation)
MAX_CONTEXT_CHARS=30000

# ==============================================================================
# LLM Generation Parameters
# ==============================================================================
# Maximum token count for LLM response (covers answer + CoT reasoning trace)
LLM_NUM_PREDICT=1024
# Generation temperature: 0.0 for deterministic factual responses, higher (0.7) for creative
LLM_TEMPERATURE=0.0

# ==============================================================================
# Vector Database Settings
# ==============================================================================
# Embedding vector dimension (768 for nomic-embed-text)
VECTOR_DIM=768
